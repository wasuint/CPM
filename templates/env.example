# Claude Project Manager Environment Configuration
# Copy this to .env and customize for your project

# Project Settings
PROJECT_NAME="My Awesome Project"
PROJECT_TYPE="mixed"
ANALYSIS_DEPTH="full"

# File Size Limits
MAX_FILE_SIZE_NEW=500
MAX_FUNCTION_LENGTH_NEW=50

# Telegram Notifications
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN="your_bot_token_here"
TELEGRAM_CHAT_ID="your_chat_id_here"

# Notification Settings  
NOTIFY_MILESTONES=true
NOTIFY_FUNCTION_COMPLETION=false
NOTIFY_ERRORS=true
NOTIFY_EXTERNAL_CHANGES=true
DAILY_SUMMARY_ENABLED=false

# Development Settings
DEBUG_MODE=false
LOG_LEVEL="INFO"
SESSION_TIMEOUT=7200
MAX_SESSION_HISTORY=50

# Database Settings
DATABASE_PATH=".cpm"
BACKUP_RETENTION_DAYS=30
AUTO_BACKUP_ENABLED=true

# Analysis Settings
SKIP_LARGE_FILES=true
LARGE_FILE_THRESHOLD=1000
INCREMENTAL_ANALYSIS=true
CACHE_ANALYSIS_RESULTS=true

# Performance Settings
ANALYSIS_TIMEOUT=300
MEMORY_LIMIT="512M"
CONCURRENT_FILE_ANALYSIS=false