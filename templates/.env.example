# Claude Project Manager Environment Configuration Template
# Copy this file to .claude-project/.env and fill in your actual values

# =============================================================================
# TELEGRAM BOT CONFIGURATION
# =============================================================================
# Required: Get these from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# Optional: Telegram notification settings
TELEGRAM_ENABLED=true
TELEGRAM_TIMEOUT=10

# =============================================================================
# PROJECT CONFIGURATION
# =============================================================================
# Project identification
PROJECT_NAME=
PROJECT_TYPE=php
PROJECT_FRAMEWORK=

# Version tracking
PROJECT_VERSION=1.0.0
CLAUDE_MANAGER_VERSION=1.0.0

# =============================================================================
# ANALYSIS SETTINGS
# =============================================================================
# Function and file size limits (for new code only)
MAX_FUNCTION_LENGTH=50
MAX_FILE_SIZE=500
ANALYSIS_TIMEOUT=300

# Code quality thresholds
MAX_CYCLOMATIC_COMPLEXITY=10
MAX_PARAMETER_COUNT=5
MIN_DOCUMENTATION_COVERAGE=80

# =============================================================================
# RULE ENFORCEMENT SETTINGS
# =============================================================================
# Legacy code protection
LEGACY_CODE_PROTECTION=true
ENFORCE_FILE_SIZE_LEGACY=false
ENFORCE_DOCUMENTATION_LEGACY=false
ENFORCE_TYPE_SAFETY_LEGACY=false

# New code standards
ENFORCE_FILE_SIZE_NEW=true
ENFORCE_DOCUMENTATION_NEW=true
ENFORCE_TYPE_SAFETY_NEW=true
ENFORCE_COMPLEXITY_LIMITS=true

# =============================================================================
# NOTIFICATION SETTINGS
# =============================================================================
# Progress notification intervals
NOTIFY_PROGRESS_INTERVAL=25
NOTIFY_ON_ERRORS=true
NOTIFY_ON_COMPLETION=true
NOTIFY_ON_SESSION_START=true
NOTIFY_ON_QUALITY_ISSUES=true

# Notification message formatting
NOTIFICATION_INCLUDE_STATS=true
NOTIFICATION_INCLUDE_NEXT_STEPS=true
NOTIFICATION_TIMEZONE=UTC

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
# Log levels: debug, info, warning, error
LOG_LEVEL=info
LOG_TO_FILE=true
LOG_TO_TELEGRAM=false
LOG_ROTATION_DAYS=30

# Log file locations (relative to .claude-project/)
LOG_FILE_ANALYSIS=logs/analysis.log
LOG_FILE_SESSION=logs/session.log
LOG_FILE_PROGRESS=logs/progress.log
LOG_FILE_ERRORS=logs/errors.log

# =============================================================================
# PERFORMANCE SETTINGS
# =============================================================================
# Caching configuration
ENABLE_CACHING=true
CACHE_DURATION=3600
CACHE_MAX_SIZE=100

# Analysis performance
PARALLEL_ANALYSIS=false
MAX_ANALYSIS_FILES=1000
ANALYSIS_MEMORY_LIMIT=256M

# =============================================================================
# DATABASE SETTINGS (JSON-based, local only)
# =============================================================================
# Database file settings
DB_BACKUP_RETENTION_DAYS=30
DB_BACKUP_FREQUENCY=daily
DB_VALIDATION_ENABLED=true

# File locking settings
FILE_LOCK_TIMEOUT=30
FILE_LOCK_RETRY_ATTEMPTS=3

# =============================================================================
# DEVELOPMENT SETTINGS
# =============================================================================
# Debug and development options
DEBUG_MODE=false
VERBOSE_OUTPUT=false
DRY_RUN_MODE=false

# Testing and validation
ENABLE_STRICT_VALIDATION=true
ENABLE_PERFORMANCE_MONITORING=false

# =============================================================================
# API INTEGRATION SETTINGS (for future use)
# =============================================================================
# External service integrations (currently unused)
# GITHUB_API_TOKEN=
# CLAUDE_API_KEY=
# OPENAI_API_KEY=

# =============================================================================
# PATH CONFIGURATION
# =============================================================================
# Analysis inclusion patterns
ANALYSIS_INCLUDE_PATHS=src,app,lib
ANALYSIS_EXCLUDE_PATHS=vendor,node_modules,tests,.git,build,dist

# File pattern matching
INCLUDE_FILE_PATTERNS=*.php,*.py
EXCLUDE_FILE_PATTERNS=*.min.*,*.test.*,*.spec.*

# =============================================================================
# SESSION MANAGEMENT
# =============================================================================
# Session timeout and cleanup
SESSION_TIMEOUT_HOURS=24
SESSION_CLEANUP_DAYS=7
SESSION_AUTO_SAVE_INTERVAL=300

# Context preservation
PRESERVE_SESSION_CONTEXT=true
MAX_CONTEXT_SIZE=10000
CONTEXT_COMPRESSION=true

# =============================================================================
# QUALITY GATES CONFIGURATION
# =============================================================================
# Quality gate thresholds
QUALITY_GATE_MIN_SCORE=80
QUALITY_GATE_BLOCK_ON_FAILURE=false
QUALITY_GATE_REQUIRED_CHECKS=type_safety,documentation

# Quality metrics
TRACK_TECHNICAL_DEBT=true
TRACK_CODE_COVERAGE=true
TRACK_COMPLEXITY_TRENDS=true

# =============================================================================
# BACKUP AND RECOVERY
# =============================================================================
# Backup configuration
AUTO_BACKUP_ENABLED=true
BACKUP_COMPRESSION=true
MAX_BACKUPS_RETAINED=10

# Recovery settings
ENABLE_CRASH_RECOVERY=true
AUTO_RECOVERY_ATTEMPTS=3

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
# Security scanning (basic)
SCAN_FOR_SECRETS=true
SCAN_FOR_VULNERABILITIES=false
SECURITY_ALERTS_TO_TELEGRAM=true

# File access security
RESTRICT_FILE_ACCESS=true
ALLOWED_EXTENSIONS=php,py,js,ts,json,md,yml,yaml

# =============================================================================
# EXPERIMENTAL FEATURES (may change)
# =============================================================================
# Feature flags for experimental functionality
ENABLE_PATTERN_LEARNING=false
ENABLE_CROSS_PROJECT_INSIGHTS=false
ENABLE_AUTOMATED_REFACTORING=false
ENABLE_AI_SUGGESTIONS=false